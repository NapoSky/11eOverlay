{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/shared", "src/renderer", "vite.config.ts"],
  "exclude": ["node_modules", "out", "dist", "tests", "src/main", "src/preload"]
}
